# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/itopscc

# Monitored service URLs (container-network names, matches docker-compose.yml)
AUTH_SERVICE_URL=http://auth-service:8000
ORDERS_SERVICE_URL=http://orders-service:8000
PAYMENTS_SERVICE_URL=http://payments-service:8000
DB_PROXY_SERVICE_URL=http://db-proxy-service:8000

# Prometheus
PROMETHEUS_URL=http://prometheus:9090

# Incident detection thresholds
ERROR_RATE_THRESHOLD=0.10
LATENCY_P95_THRESHOLD_SECONDS=1.0
AVAILABILITY_THRESHOLD=0.99
POLL_INTERVAL_SECONDS=15

# LLM (Google Gemini) - optional. If GEMINI_API_KEY is empty, RCA falls
# back to rule-based summaries only (graceful degradation, see
# app/rca/llm_explainer.py). CODE-QUALITY NOTE: this used to say
# ANTHROPIC_API_KEY here, left over from an earlier design - the actual
# code has always called Gemini. Fixed as part of this upgrade (see
# CHANGELOG_IMPROVEMENTS.md).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
LLM_ENABLED=true

# CORS
CORS_ORIGINS=*

# --- Auth (Priority 4) ---
# JWT_SECRET_KEY signs every login token. The fallback in code
# ("dev-only-jwt-secret-change-me") is intentionally obviously-fake -
# ALWAYS set a real random value outside a personal local demo, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-jwt-secret-change-me
JWT_EXPIRE_MINUTES=480

# Demo user seed passwords (one per role - see main.py::seed_reference_data).
# NEVER real secrets: these are the interview-demo login credentials for
# the 4 seeded accounts (admin / it_support / incident_manager /
# rca_reviewer, same username as the role). Change all four before using
# this anywhere beyond a personal/local demo.
SEED_ADMIN_PASSWORD=changeme-admin
SEED_IT_SUPPORT_PASSWORD=changeme-itsupport
SEED_INCIDENT_MANAGER_PASSWORD=changeme-incidentmgr
SEED_RCA_REVIEWER_PASSWORD=changeme-rcareviewer

# Fault-injection admin auth (auth/orders/payments/db-proxy services).
# Every /admin/* endpoint (inject-latency, inject-errors, simulate-down,
# etc.) requires this exact value in the X-Admin-Token header - these
# endpoints can force a "production" service into a down/error state, so
# they must not be open to anyone who can reach the port. Change this to
# a real random secret outside local development.
FAULT_INJECTION_TOKEN=dev-admin-token-change-me
